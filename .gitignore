# kit:begin core
# Agent-client local state. Shared skills, settings and tools remain tracked.
.worktrees/
.codex-log/
CLAUDE.local.md
.claude/settings.local.json
.claude/agent-memory-local/
# Working captures from a visual check; milestone captures and notes.md are committed.
docs/visual/screenshots/*/work/
# Windows alternate-data-stream files created when downloads are unpacked into WSL.
*:Zone.Identifier
__pycache__/
# kit:end core

# kit:begin mcp-playwright
# Page snapshots and console logs written by the Playwright MCP server.
.playwright-mcp/
# kit:end mcp-playwright

# Project: Node, Medusa and Next.js (from the Medusa DTC starter's root .gitignore, 2026-10-06).
# apps/backend/.gitignore adds the backend's own entries (.medusa, uploads and so on).
node_modules/
.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
coverage
**/.next/
**/out/
**/build
**/dist
*.tsbuildinfo
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.turbo
.vscode
.vercel
.DS_Store
._*
Thumbs.db

# Env files. Never commit; .env.template files carry the variable names.
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/.env.e2e

# Playwright Test output (apps/storefront)
**/test-results/
**/playwright-report/
**/playwright/.cache/

# Project-specific Codex command rules. The agent kit writes kit.rules next to this file and never
# touches this one. Example:
#
# prefix_rule(
#     pattern = ["supabase", "db", "push"],
#     decision = "forbidden",
#     justification = "Remote migrations are the user's to run",
# )

# Database and deploy commands are Oscar's to run (docs/decisions.md, "Database and deployment
# workflow"). Codex prefixes are literal, so each command is listed with and without npx.

prefix_rule(
    pattern = ["npx", "medusa", "db:migrate"],
    decision = "forbidden",
    justification = "Database and deploy commands are Oscar's to run.",
    match = ["npx medusa db:migrate"],
)

prefix_rule(
    pattern = ["medusa", "db:migrate"],
    decision = "forbidden",
    justification = "Database and deploy commands are Oscar's to run.",
    match = ["medusa db:migrate"],
)


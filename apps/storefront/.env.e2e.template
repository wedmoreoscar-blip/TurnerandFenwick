# Settings for the Playwright end-to-end suite (npm run test:e2e). Copy to .env.e2e, which is never
# committed. The suite runs against the dev servers only.

# Where the running dev servers are.
E2E_STOREFRONT_URL=http://localhost:8000
E2E_BACKEND_URL=http://localhost:9000
# The storefront's country code for the UK region.
E2E_COUNTRY_CODE=gb

# A dedicated admin user for the suite, created with:
#   cd apps/backend && npx medusa user -e <email> -p <password>
# The suite only reads notifications with it. Quote the password if it contains # or spaces
# (E2E_ADMIN_PASSWORD="..."): unquoted, everything from a # on is read as a comment.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# A real mailbox you own. Each test sends to a plus-address of it, for example you+e2e-123@gmail.com,
# so the emails it triggers land with you and nothing goes to a made-up address.
E2E_EMAIL=

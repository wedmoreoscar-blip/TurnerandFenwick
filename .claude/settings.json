{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(./.env.local)",
      "Read(**/.env.local)",
      "Read(./.env.development)",
      "Read(**/.env.development)",
      "Read(./.env.production)",
      "Read(**/.env.production)",
      "Read(./.env.test)",
      "Read(**/.env.test)",
      "Read(./.env.staging)",
      "Read(**/.env.staging)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push *)"
    ],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/tools/writespec-guard\"",
            "statusMessage": "Checking writespec compliance...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|Agent|Task"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PROJECT_DIR}/tools/spend-guard\"",
            "statusMessage": "Checking delegation spend ledger...",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
